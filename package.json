{
  "name": "tsmv",
  "version": "0.1.0",
  "type": "module",
  "description": "Move TS/JS files and folders, and rewrite the imports that point to them",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/misebox/tsmv.git"
  },
  "homepage": "https://github.com/misebox/tsmv#readme",
  "bugs": "https://github.com/misebox/tsmv/issues",
  "keywords": [
    "typescript",
    "javascript",
    "move",
    "rename",
    "refactor",
    "refactoring",
    "codemod",
    "import",
    "imports",
    "require",
    "paths",
    "alias",
    "tsconfig",
    "cli",
    "mv"
  ],
  "bin": {
    "tsmv": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/worker.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "bun test ./test",
    "build": "bun build src/cli.ts src/worker.ts --target=node --external oxc-parser --outdir dist",
    "build:bin": "bun build src/main.ts src/worker.ts --compile --outfile dist/tsmv-darwin-arm64",
    "bench": "bun bench/run.ts"
  },
  "devDependencies": {
    "typescript": "5"
  },
  "dependencies": {
    "oxc-parser": "^0.155.0"
  }
}
